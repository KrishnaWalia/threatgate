# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Set to "true" once MySQL is set up and schema/schema.sql has been
# run. While false, auth runs entirely on an in-memory demo user
# store (see backend/store/userStore.js) and /api/dashboard/* routes
# return 503 instead of touching MySQL. This lets the landing page
# and login system work standalone before the database exists.
USE_DB=false

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=threatgate

# Long random string — used to sign and verify JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long an access token stays valid.
JWT_EXPIRES_IN=8h

# Where the React dev server runs, for CORS + Socket.io.
CLIENT_ORIGIN=http://localhost:5173

# When true AND USE_DB=true, a mock attack generator inserts fake
# attack_logs rows every couple of seconds and emits them over
# Socket.io. Has no effect while USE_DB=false. Turn this OFF once
# Track A (proxy) and Track B (real pipeline) are wired in during
# integration — real traffic will populate the feed instead.
DEMO_MODE=true
