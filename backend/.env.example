# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=threatgate

# Long random string — used to sign and verify JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long an access token stays valid.
JWT_EXPIRES_IN=8h

# Where the React dev server runs, for CORS + Socket.io.
CLIENT_ORIGIN=http://localhost:5173

# When true, a mock attack generator inserts fake attack_logs rows
# every couple of seconds and emits them over Socket.io. Turn this
# OFF once Track A (proxy) and Track B (real pipeline) are wired in
# during integration — real traffic will populate the feed instead.
DEMO_MODE=true
