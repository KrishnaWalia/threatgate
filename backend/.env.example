# Copy to .env (the zip already ships a ready-to-run .env with a generated secret).
# Never commit .env.

# ---------------- Dashboard API (Track C) ----------------
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Long random string used to sign/verify JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h

# ---------------- Storage ----------------
# false = everything in memory, no MySQL needed (resets on restart).
# true  = use MySQL (run schema/schema.sql, then `npm run seed`).
USE_DB=false
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=threatgate

# ---------------- WAF proxy (Track A) ----------------
WAF_PORT=8080
TARGET_URL=http://localhost:3000
WAF_ORG_ID=1
# A request is blocked (403) when its risk score is >= this (0-100).
BLOCK_THRESHOLD=50
# DEMO ONLY: trust the X-Forwarded-For header as the client IP so
# `npm run attack` can pretend to be many different IPs. In production
# behind no proxy, set this to false — otherwise anyone can spoof their IP.
TRUST_XFF=true

# ---------------- Brute force / rate limit (Track B) ----------------
# Login path matcher (regex) — a 401/403 response here counts as a failed login.
LOGIN_PATH_REGEX=/(login|signin|sign-in|auth)\b
LOGIN_FAIL_MAX=5
LOGIN_FAIL_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=10000
ATTACK_STRIKE_MAX=8
ATTACK_STRIKE_WINDOW_MS=60000
# How long an auto-block lasts (default 5 minutes).
BLOCK_DURATION_MS=300000

# Fake traffic generator for an empty dashboard (not needed with the real proxy).
DEMO_MODE=false
